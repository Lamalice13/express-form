<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <% if(locals.users && locals.users.length > 0) { %> <% users.forEach(user =>
    { %>
    <h1>Searched Users</h1>
    <ul>
      <li>First name: <%= user.firstname %></li>
      <li>Last name: <%= user.lastname %></li>
      <li>Email: <%= user.email %></li>
      <li>
        Date of birth: <%= user.date_of_birth.toISOString().split("T")[0] %>
      </li>
      <% if (user.bio) { %>
      <li><%= user.bio %></li>
      <%}%>
    </ul>
    <% }) %> <% } else { %>
    <h2>Sorry, we didn't find anyone by this name</h2>
    <% } %>
    <a href="/" style="display: block">Go back</a>
  </body>
</html>
