<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <h1><%= title %></h1>
    <% if(locals.errors) { %> <%- include("partials/errors.ejs", { errors }) %>
    <% } %>
    <form action="/create" method="POST">
      <label for="firstName">First Name: </label>
      <input
        type="text"
        name="firstName"
        id="firstName"
        required
        value="<%= locals.users ? users.firstName : ''%>"
      />
      <label for="lastName">Last Name: </label>
      <input
        type="text"
        name="lastName"
        id="lastName"
        required
        value="<%= locals.users ? users.lastName : '' %>"
      />
      <label for="email">Email: </label>
      <input
        type="email"
        name="email"
        id="email"
        required
        value="<%= locals.users ? users.email : '' %>"
      />
      <label for="age">Age: </label>
      <input
        type="date"
        name="age"
        id="age"
        required
        value="<%= locals.users ? users.age : '' %>"
      />
      <label for="bio">Bio: </label>
      <input
        type="text"
        name="bio"
        id="bio"
        value="<%= locals.users ? users.bio : '' %>"
      />
      <button type="submit">Submit</button>
    </form>

    <hr />
    <a href="/">Back to home</a>
  </body>
</html>
