<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <h1><%= title %></h1>
    <% if(locals.errors) { %> <%- include("partials/errors.ejs") %> <% } %>
    <form action="/<%= user.id %>/update" method="POST">
      <input
        type="text"
        name="firstName"
        value="<%= user.firstname %>"
        required
      />
      <input
        type="text"
        name="lastName"
        value="<%= user.lastname %>"
        required
      />
      <input
        type="email"
        name="email"
        id="email"
        value="<%= user.email %>"
        required
      />
      <input
        type="date"
        name="age"
        id="age"
        required
        value="<%= user.date_of_birth.toISOString().split('T')[0] %>"
      />
      <input type="text" name="bio" id="bio" value="<%= user.bio %>" />
      <button type="submit">Update User</button>
    </form>
    <a href="/">Back to home</a>
  </body>
</html>
