<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1><%= title %></h1>
    <ul>
      <% if (locals.users) { %> <% users.forEach(user => { %>
      <li>
        ID: <%= user.id %>
        <br />
        Name: <%= user.firstname %> <%= user.lastname %>
        <br />
        Email: <%=user.email %>
        <br />
        Age: <%= new Date(user.date_of_birth).toLocaleDateString({ day:
        "numeric", year:"numeric", month: "long" }) %>
        <br />
        Bio: <%= user.bio %>
      </li>
      <a href="/<%= user.id %>/update">Update</a>

      <form
        action="/<%= user.id %>/delete"
        method="POST"
        style="display: inline"
      >
        <button
          type="submit"
          onclick="return confirm('Are you sure want to delete this user?');"
        >
          Delete
        </button>
      </form>
      <% }); %> <% } %>
    </ul>
    <a href="/create">Create a user</a>

    <h2>Search for a user with his last name or email</h2>
    <form action="/search" method="GET">
      <% if(locals.searchErrors) { %> <%- include("partials/errors.ejs", {
      errors: searchErrors }) %> <% }%>

      <label for="lastName">Last name</label>
      <input
        type="text"
        name="lastName"
        id="lastName"
        value="<%= locals.userErr ? userErr.lastName : '' %>"
      />
      <label for="email">Email</label>
      <input
        type="email"
        name="email"
        id="email"
        value="<%= locals.userErr ? userErr.email : '' %>"
      />
      <button type="submit" style="display: block">Search</button>
    </form>
  </body>
</html>
